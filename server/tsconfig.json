{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "useDefineForClassFields": false,
    "paths": {
      "@stations/*": [
        "../shared/stations/*"
      ]
    }
  },
  "include": [
    "src",
    "scripts"
  ],
  "exclude": [
    "src/stations/**/*.test.ts",
    "src/stations/vitest.config.ts"
  ]
}
