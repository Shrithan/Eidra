TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:2567/auth/twitch/callback
SESSION_SECRET=
# Credentials absent => mock mode. Sessions and refresh tokens persist in data/.
# Keep SESSION_SECRET stable across restarts.
HYPE_TO_TWITCH=0

# Optional public city/country research. Off by default; no key is sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
RESEARCH_ENABLED=0
# Counts attempted logins, reserved durably before each LLM batch. 0 disables spending.
RESEARCH_DAILY_BUDGET=100
RESEARCH_CONCURRENCY=1
